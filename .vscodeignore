# ============================================================
# .vscodeignore — 控制打进 .vsix 的文件
# 原则：只发布「运行所需」的编译产物，排除所有源码/依赖/调试文件
# ============================================================

# ---------- 依赖（严禁进包，单 esbuild 就 ~10MB）----------
node_modules
webview/node_modules

# ---------- 源码（运行时只认 out/ 与 dist/）----------
src
webview

# ---------- Source maps（调试用，发布不需要）----------
**/*.map

# ---------- 测试 & 编辑器配置 ----------
.vscode-test
.vscode

# ---------- 开发脚本（非扩展运行所需）----------
optimize-copy.py

# ---------- 打包产物自身 ----------
*.vsix

# ---------- 工作流文档（可选，按需保留）----------
WORKFLOW.md

# ============================================================
# 强制保留编译产物
# dist/ 与 out/ 被 .gitignore 忽略，这里用否定规则放行，
# 确保 vsce 打包时一定包含它们。
# ============================================================
!dist
!dist/**
!out
!out/**
